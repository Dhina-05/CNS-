def generate_matrix(key):\par
    key = ''.join(sorted(set(key), key=lambda x: key.index(x)))  \par
    key = key.replace('J', 'I') \par
    matrix = key + 'ABCDEFGHIKLMNOPQRSTUVWXYZ'\par
    matrix = ''.join(sorted(set(matrix), key=lambda x: matrix.index(x)))  \par
    return [matrix[i:i + 5] for i in range(0, len(matrix), 5)]\par
\par
def find_position(matrix, char):\par
    for i, row in enumerate(matrix):\par
        if char in row:\par
            return i, row.index(char)\par
    return None\par
\par
def preprocess_message(message):\par
    message = message.replace(" ", "").upper()  \par
    new_message = []\par
    for i in range(0, len(message), 2):\par
        if i + 1 < len(message) and message[i] == message[i + 1]:\par
            new_message.append(message[i] + 'X')\par
        else:\par
            new_message.append(message[i:i + 2])\par
    if len(new_message[-1]) == 1:\par
        new_message[-1] += 'X'  \par
    return ''.join(new_message)\par
\par
def encrypt(message, matrix):\par
    encrypted_message = []\par
    message = preprocess_message(message)\par
    for i in range(0, len(message), 2):\par
        x1, y1 = find_position(matrix, message[i])\par
        x2, y2 = find_position(matrix, message[i + 1])\par
        if x1 == x2:  \par
            encrypted_message.append(matrix[x1][(y1 + 1) % 5])\par
            encrypted_message.append(matrix[x2][(y2 + 1) % 5])\par
        elif y1 == y2:  \par
            encrypted_message.append(matrix[(x1 + 1) % 5][y1])\par
            encrypted_message.append(matrix[(x2 + 1) % 5][y2])\par
        else:  \par
            encrypted_message.append(matrix[x1][y2])\par
            encrypted_message.append(matrix[x2][y1])\par
    return ''.join(encrypted_message)\par
\par
def decrypt(message, matrix):\par
    decrypted_message = []\par
    for i in range(0, len(message), 2):\par
        x1, y1 = find_position(matrix, message[i])\par
        x2, y2 = find_position(matrix, message[i + 1])\par
        if x1 == x2:  \par
            decrypted_message.append(matrix[x1][(y1 - 1) % 5])\par
            decrypted_message.append(matrix[x2][(y2 - 1) % 5])\par
        elif y1 == y2:  \par
            decrypted_message.append(matrix[(x1 - 1) % 5][y1])\par
            decrypted_message.append(matrix[(x2 - 1) % 5][y2])\par
        else:  \par
            decrypted_message.append(matrix[x1][y2])\par
            decrypted_message.append(matrix[x2][y1])\par
    return ''.join(decrypted_message).replace('X', '')\par
